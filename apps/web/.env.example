# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used for Google OAuth redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI engine (Python FastAPI sidecar locally, GCP Cloud Run in production).
# When unreachable, the built-in basic engine (solid backgrounds) is used.
AI_ENGINE_URL=http://127.0.0.1:8000

# Desktop (Electron) builds only: hosted web URL that performs admin-only auth steps,
# because the desktop bundle never contains SUPABASE_SERVICE_ROLE_KEY.
# SPRITECUT_CLOUD_URL=https://your-domain

# Development only: lets you browse logged-in screens without Supabase (mock guest session).
NEXT_PUBLIC_UI_PREVIEW=0
